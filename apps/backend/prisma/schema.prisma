generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  useCelsius Boolean  @default(true)
  darkMode   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  devices   Device[]
  wardrobes Wardrobe[]

  @@map("users")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("activity_logs")
}

model Device {
  id              Int      @id @default(autoincrement())
  userId          Int
  name            String
  macAddress      String
  batteryLevel    Int?
  firmwareVersion String
  pairedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model Wardrobe {
  id           Int      @id @default(autoincrement())
  userId       Int
  apparel_name String
  photo        String?
  type         String
  material     String
  color        String
  season       String
  event        String
  date_added   DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wardrobes")
}
